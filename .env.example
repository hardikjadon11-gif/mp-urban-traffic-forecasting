# =============================================================
# Smart Traffic Congestion Forecasting System — Environment Config
# =============================================================
# Copy this file to .env and adjust values as needed.

# --- Data Paths ---
DATA_DIR=../data
METR_LA_PATH=../data/metr-la/metr-la.h5
PEMS_BAY_PATH=../data/pems-bay/pems-bay.h5
UBER_MOVEMENT_PATH=../data/uber-movement/uber-zones.csv
DEMO_DATA_DIR=../data/demo

# --- Database ---
DATABASE_URL=sqlite:///./traffic_forecasting.db

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Model Defaults ---
DEFAULT_MODEL=stgcn
FORECAST_HORIZONS=30,60

# --- Training Defaults ---
DEFAULT_EPOCHS=50
DEFAULT_BATCH_SIZE=32
DEFAULT_LEARNING_RATE=0.001
SEQUENCE_LENGTH=12

# --- Data Fusion Weights ---
METR_LA_WEIGHT=0.5
PEMS_BAY_WEIGHT=0.3
UBER_WEIGHT=0.2

# --- Congestion Thresholds (mph) ---
CONGESTION_FREE_THRESHOLD=45
CONGESTION_MODERATE_THRESHOLD=25

# --- Sampling ---
RESAMPLE_INTERVAL_MINUTES=15

# --- Train/Val/Test Split Ratios ---
TRAIN_RATIO=0.7
VAL_RATIO=0.15
TEST_RATIO=0.15

# --- Demo Mode ---
DEMO_MODE=true
